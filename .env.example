# ---------------------------------------------------------------------------
# LLM provider (optional)
#
# Signal works with no key at all: the deterministic engine produces the score,
# the matched/missing skills, the category breakdown and the counterfactuals.
# A key only adds the written narrative on top.
#
# Set ONE of the blocks below. The server picks the first one it finds, in the
# order listed here. See README "Choosing a provider" for the free-tier notes.
# ---------------------------------------------------------------------------

# Groq — recommended. Fastest free tier, no card required.
# Key: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — largest free daily allowance.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — one key, many free models (look for the ":free" suffix).
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras — very fast Llama inference, free tier.
# Key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Optional: pin a specific model instead of the provider default.
# LLM_MODEL=llama-3.3-70b-versatile
